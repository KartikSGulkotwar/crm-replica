{
  "name": "@crm-replica/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Define CRM objects, fields and views as code (push them with the crm CLI).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm-replica/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
