# Copy to .env and adjust. Defaults match docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173

# Used from Phase 2 onward
JWT_SECRET=change-me-to-a-long-random-string
# Used from Phase 10 onward
ANTHROPIC_API_KEY=
# Optional, Phase 9 (send email action). Emails are logged when unset.
RESEND_API_KEY=

# Namespace for background-job keys in Redis (rarely needs changing).
BULLMQ_PREFIX=crm
