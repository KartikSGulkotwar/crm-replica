# Copy to .env and adjust. Defaults match docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173

# Signs session cookies. Required in production (32+ chars): openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Sign-up / login / accept-invite attempts allowed per IP per minute.
AUTH_RATE_LIMIT=10
# All other API requests allowed per user (or API key) per minute.
API_RATE_LIMIT=600
# AI assistant ("Ask the CRM") and the workflow AI step (Phase 10). Get a key at
# https://console.anthropic.com. Without it, the AI features show how to set them up.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Assistant questions allowed per user per minute.
AGENT_RATE_LIMIT=20
# Workflows (Phase 9). Without RESEND_API_KEY, workflow emails are only logged by the worker.
RESEND_API_KEY=
EMAIL_FROM=CRM Replica <onboarding@resend.dev>
# Let workflow HTTP steps call private/internal addresses (localhost, 10.x, ...). Keep false in production.
WORKFLOW_HTTP_ALLOW_PRIVATE=false

# Namespace for this app's keys in Redis: background jobs and rate-limit counters (rarely needs changing).
BULLMQ_PREFIX=crm
