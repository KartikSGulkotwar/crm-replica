{
  "name": "@crm-replica/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ worker. Runs background jobs (workflows from Phase 9) using the server's compiled modules.",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,run \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --watch-path=../server/dist dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@crm-replica/server": "workspace:*",
    "@crm-replica/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "bullmq": "^5.81.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15"
  }
}
